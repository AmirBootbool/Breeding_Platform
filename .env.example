DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=wheatbreeding
POSTGRES_USER=wheatuser
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgres://wheatuser:changeme@db:5432/wheatbreeding
USE_SQLITE=True

# Production HTTPS hardening (enable only after HTTPS is working)
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True

# Sentry Configuration (optional, production only)
# SENTRY_DSN=https://your-public-key@o0.ingest.sentry.io/your-project-id
# SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_PROFILES_SAMPLE_RATE=0.1
